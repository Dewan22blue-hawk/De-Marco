# Database connection (PUBLIC Supabase project ONLY — never use local Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Master Key for AI Key Vault (Must be a secure random string, at least 32 characters recommended)
# Used to encrypt and decrypt organization-specific AI provider keys (e.g., Gemini) in the database.
AI_KEY_ENCRYPTION_SECRET=your_32_character_super_secret_string_here

# Global Fallback for Gemini (Optional)
# Used if an organization has not configured their own AI API Key.
GEMINI_API_KEY=your_gemini_api_key_here

# N8N Integration
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here
